{{define "style"}}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.colors.min.css">
<style>
    section.pico {
        margin: 0 auto;
        padding: 2rem;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        background-color: rgb(39, 42.5, 50.5);
        width: 100%;
        max-width: 600px;
    }

    .auth-links {
        display: flex;
        /* Use flexbox layout */
        justify-content: space-between;
        /* Spread out items with space in between */
        width: 100%;
        /* Ensure the container takes up the full width */
    }

    .auth-links p {
        font-size: medium;
        margin: 0;
        /* Remove default margin */
    }
</style>
{{end}}
{{define "page"}}
<section class="pico" class="pico-color-red-150">
    <h2>Reset password</h2>
    <form action="/password-reset" method="post">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" placeholder="Enter Email" aria-label="email address"
            autocomplete="email" required {{if .Email}}value="{{.Email}}" {{end}} autofocus />
        {{csrfField}}
        <button type="submit">Submit</button>
    </form>
    <div class="auth-links">
        <p>No account? <a href="/signup">Sign up</a></p>
        <p>Remember password? <a href="/signin">Sign in</a></p>
    </div>
</section>
{{end}}